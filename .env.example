# Copy to .env.local for local dev, and add the same keys as GitHub Actions secrets for production builds.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Contact form: production posts to /contact.php (Hostinger mail → hello@vittesh.com).
# Web3Forms is an optional extra path. Create an access key at https://web3forms.com
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# After first deploy with Supabase, run supabase/site_visitors.sql in the SQL editor.
# Put Cloudflare (free) in front of vittesh.com for DDoS protection and caching.
